# Copy to .env and adjust. Every value has a sensible default except WEATHERAPI_KEY.

# Free key from https://www.weatherapi.com/signup.aspx – without it only Open-Meteo is collected.
WEATHERAPI_KEY=

# Once a day, at FETCH_TIME in each location's own timezone, today's forecast is collected.
FETCH_TIME=06:00
RETRY_INTERVAL_MINUTES=30
MAX_ATTEMPTS_PER_DAY=4

# Comma-separated list of enabled providers
PROVIDERS=open_meteo,weatherapi

# Database credentials (used by the bundled PostgreSQL container)
DB_NAME=weather
DB_USER=weather
DB_PASSWORD=change-me

# API
API_PORT=8080
# If set, every /api request needs "Authorization: Bearer <token>" (or ?token=)
API_TOKEN=

# HTTP behaviour towards providers
HTTP_TIMEOUT_SECONDS=15
HTTP_MAX_RETRIES=2

# Keep the raw provider response per run (JSONB) for auditing/reprocessing
STORE_RAW_PAYLOAD=true
LOG_LEVEL=info
